# Copy to .env and fill in with real values. Never commit .env.

# Supabase project (Settings -> API)
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
# Server-only — bypasses RLS. Never expose to the browser (no VITE_ prefix).
SUPABASE_SERVICE_ROLE_KEY=""

# Same values, exposed to the browser bundle by Vite's VITE_ prefix convention.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Optional — only needed to run migrations via the Supabase CLI instead of
# pasting SQL into the dashboard. Generate at supabase.com/dashboard/account/tokens.
# Account-level credential — treat it like a password.
SUPABASE_ACCESS_TOKEN=""

# Encrypts and signs the session cookie that holds your signed-in users'
# Supabase tokens — this is the actual secret protecting every session, so
# treat it exactly like a database password. 32+ random characters, unique
# per environment (never reuse the same value across dev/staging/prod, and
# never commit a real one). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# AI Assistant — Groq (free tier, no credit card/billing account needed).
# Get a key at console.groq.com/keys. Never expose to the browser (no VITE_ prefix).
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

# Set to "false" to run a free beta — suspends the trial-expiry read-only
# lock and hides the checkout UI, without removing any billing code. Set to
# "true" (or unset) for normal paid-plan enforcement.
BILLING_ENABLED="true"

# Billing — Paynow (paynow.co.zw). Get these from your Paynow merchant
# dashboard once your merchant account is approved (Integration Setup ->
# Create Integration -> "Ecommerce" type). Never expose to the browser.
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""

# Separate key for authenticated encryption of seller-owned payment credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Server-only. Keep the previous key in SHOP_PAYMENT_ENCRYPTION_KEY_PREVIOUS
# during rotation until every credential encrypted with it has been accessed
# and re-encrypted. Rotation is lazy; there is no bulk re-encryption job.
SHOP_PAYMENT_ENCRYPTION_KEY=""
SHOP_PAYMENT_ENCRYPTION_KEY_PREVIOUS=""

# Base URL this app is served at — used to build Paynow's webhook
# (resulturl) and return URL, and the parent host for public shops.
# No trailing slash.
# Dev: http://localhost:8080  Prod: https://yourdomain.com
# Each published shop is http://{slug}.localhost:8080 in dev, and
# https://{slug}.yourdomain.com in production. Add a wildcard DNS record
# (*.yourdomain.com) on the host. Draft preview stays on APP_URL because
# the sign-in cookie is not sent to shop subdomains.
# The Vite build copies APP_URL into the browser as VITE_APP_URL.
APP_URL="http://localhost:8080"

# Official production host is Google Cloud Run. Render is temporary.
# Cloud Run sets PORT. VITE_* values are baked in at image build time.

# Shop URL mode. true (deploy default) = https://{slug}.yourdomain.com.
# false only for hosts that cannot take extra labels (*.run.app).
# Unset: subdomains on custom domains and localhost; path URLs on *.run.app.
SHOP_HOSTS=""
VITE_SHOP_HOSTS=""

# The one and only platform-admin account — grants access to /admin
# (cross-business billing overrides + platform stats, hidden from everyone
# else). Your Supabase auth user ID (auth.users.id) on this project. Never
# grantable through the app itself — only by editing this value directly.
# Leave empty to disable platform-admin access entirely.
PLATFORM_ADMIN_USER_ID=""

# Optional — caches the per-user workspace lookup (business/role/plan, hit
# on nearly every page load) at the edge. Leave empty to skip caching
# entirely; the app falls straight through to Postgres, same as before this
# existed. Get these from your Upstash Redis database's REST API tab
# (upstash.com) — the REST client, not a raw redis:// connection string.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional — error tracking (sentry.io, free tier). Leave empty to skip
# entirely; nothing is sent anywhere until this is set. Read on both the
# client and server (src/lib/monitoring/sentry.ts) — Sentry DSNs are meant
# to be public, so no separate server-only secret is needed. Get one from
# your Sentry project's Settings -> Client Keys (DSN).
VITE_SENTRY_DSN=""

# Transactional shop emails via Resend. Verify mykwetuu.com in Resend first.
# Keep the API key server-only; the outbox remains queued until configured.
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL="Kwetuu <noreply@mykwetuu.com>"
# Used by the scheduled GitHub Actions job to authenticate its mail flush call.
MAIL_FLUSH_SECRET=""
# NOTIFY_FROM_EMAIL must be a domain Resend will accept. MAIL_FLUSH_SECRET
# (16+ chars) authorizes POST /api/internal/flush-mail for cron. WhatsApp
# Cloud is not used. Supabase dashboard SMTP still sends Auth confirm/reset.
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL=""
MAIL_FLUSH_SECRET=""
